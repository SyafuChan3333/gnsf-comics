---
import classNames from 'classnames';
import Footer from '../components/Footer.astro';
import { siteAbsPath } from '@/libs/astro';
import * as styles from '@/styles/layouts/Layout.css';

interface Props {
	title?: string;
	className?: string;
}

const { title = "4コマ漫画ポートフォリオ", className } = Astro.props;
---

<!doctype html>
<html lang="ja" class={styles.base}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={siteAbsPath("/favicon.svg")} />
		<link rel="icon" href={siteAbsPath("/favicon.ico")} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class={styles.base}>
		<header class={styles.header}>
			<div class={styles.headerContainer}>
				<a href={siteAbsPath("/")} class={styles.siteTitle}>📚 4コマ漫画ギャラリー</a>
				<nav>
					<!-- <a href={siteAbsPath("/about")} class={styles.navigationLink}>作者について</a> -->
				</nav>
			</div>
		</header>
		<main class={classNames(styles.mainContent, className)}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

